{
  "name": "horizonte-payments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api": "pnpm --filter @horizonte/payments-api start",
    "worker": "pnpm --filter @horizonte/payments-worker start",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run backend/tests worker/tests/unit",
    "test:integration": "node worker/tests/run-integration.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "testcontainers": "12.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
